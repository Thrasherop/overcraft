{
	"schemaVersion": 1,
	"id": "overcraft",
	"version": "${version}",
	"name": "Overcraft",
	"description": "Overwatch heroes in Minecraft: pick a hero when you join a world; hotbar slot 1 holds the hero's weapons and abilities.",
	"authors": ["ultraprim"],
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.overcraft.Overcraft"],
		"client": ["dev.overcraft.client.OvercraftClient"]
	},
	"mixins": [
		"overcraft.mixins.json",
		"overcraft-replay.mixins.json",
		{
			"config": "overcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "overcraft-replay.classtweaker",
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20"
	}
}
